---
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $CI_COMMIT_TAG
  auto_cancel:
    on_new_commit: interruptible

default:
  interruptible: true

stages:
  - lint
  - test
  - release

include:
  - local: '.gitlab/ci/**/.gitlab-ci.yml'

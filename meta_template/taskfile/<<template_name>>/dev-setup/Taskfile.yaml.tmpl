version: '3'

tasks:
  default:
    desc: Bootstrap dev setup
    cmds:
      - task: venv
      - uv run << pre_commit_tool >> install

  venv:
    desc: Install dev requirements
    cmds:
      - uv sync

  venv:ci:
    desc: Install dev requirements, failing if uv.lock is out of date
    cmds:
      - uv sync --locked

  maintenance:
    desc: Project maintenance automation
    cmds:
      - uv run << pre_commit_tool >> autoupdate
      - task: maintenance:requirements

  maintenance:requirements:
    vars:
      CLI_ARGS: '{{.CLI_ARGS | default "--upgrade" }}'
    cmds:
      - task: venv
      - uv lock {{.CLI_ARGS}}

{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/copier\\.ya?ml$/"
      ],
      "matchStrings": [
        "_min_copier_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "depNameTemplate": "copier",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "<<template_dir>>/**"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "astral-sh/uv"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "copier"
      ],
      "automerge": true,
      "groupName": "copier",
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": [
        "go-task/task"
      ],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "extends": [
<% if vcs_platform == 'github' %>
    "customManagers:githubActionsVersions",
<% elif vcs_platform == 'gitlab' %>
    "customManagers:gitlabPipelineVersions",
<% endif %>
    "config:best-practices"
  ],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json"
}

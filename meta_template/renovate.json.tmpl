{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/copier\\.ya?ml$/"
      ],
      "matchStrings": [
        "_min_copier_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "depNameTemplate": "copier",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
<% if vcs_platform == 'gitlab' and gitlab_docker %>
    {
      "description": "The Docker client and its plugins are released together, so are updated together",
      "matchDatasources": [
        "deb"
      ],
      "matchPackageNames": [
        "docker-ce-cli",
        "docker-buildx-plugin",
        "docker-compose-plugin"
      ],
      "groupName": "Docker client",
      "automerge": true,
      "prConcurrentLimit": 10
    },
<% endif %>
<% if include_actions_lockfile %>
    {
      "description": "actions.lock pins actions to commits, and gh actions-lock rewrites digest refs back to tags. Possibly unnecessary with the 'Require actions to be pinned to a full-length commit SHA' policy enabled, under which gh actions-lock is documented to keep digest refs (untested).",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": false
    },
<% endif %>
    {
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "<<template_dir>>/**"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchPackageNames": [
        "astral-sh/uv"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchPackageNames": [
        "copier"
      ],
      "automerge": true,
      "groupName": "copier",
      "rangeStrategy": "bump",
      "prConcurrentLimit": 10
    },
    {
      "description": "Matched by depName, as GitLab CI looks Task up in its apt repo under packageName task",
      "matchDepNames": [
        "go-task/task"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "prConcurrentLimit": 10
  },
  "prConcurrentLimit": 7,
  "extends": [
<% if vcs_platform == 'github' %>
    "customManagers:githubActionsVersions",
<% elif vcs_platform == 'gitlab' %>
    "customManagers:gitlabPipelineVersions",
<% endif %>
    "config:best-practices"
  ],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json"
}

{
  "customManagers": [
    {
      "description": "matchStrings copied verbatim from the customManagers:githubActionsVersions/gitlabPipelineVersions presets (which only scan .github/workflows and .gitlab-ci.yml), so annotations behave the same in the template's .tmpl files. Update together.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tmpl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_VERSION\\s*:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/copier\\.ya?ml\\.tmpl$/",
        "/copier\\.ya?ml$/"
      ],
      "matchStrings": [
        "_min_copier_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "depNameTemplate": "copier",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/pyproject\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "\"copier>=(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "copier",
      "datasourceTemplate": "pypi"
    }
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/^meta_template/.+/workflows/.+\\.tmpl$/"
    ]
  },
  "packageRules": [
    {
      "description": "Template updates use build commits, which trigger a patch release (see tool.semantic_release in pyproject.toml) so users get them on copier update.",
      "matchFileNames": [
        "meta_template/**"
      ],
      "semanticCommitType": "build"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchPackageNames": [
        "astral-sh/uv"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchPackageNames": [
        "copier"
      ],
      "automerge": true,
      "groupName": "copier",
      "rangeStrategy": "bump",
      "prConcurrentLimit": 10
    },
    {
      "matchPackageNames": [
        "go-task/task"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "description": "Template updates that need review: majors can change what generated projects get on copier update, and a digest change on a full-version tag means the tag was moved upstream. Must stay after the automerge rules above, to override their automerge and prConcurrentLimit.",
      "matchFileNames": [
        "meta_template/**"
      ],
      "matchUpdateTypes": [
        "major",
        "digest"
      ],
      "automerge": false,
      "prConcurrentLimit": 7
    },
    {
      "description": "Release template majors as a minor version, listed under Features.",
      "matchFileNames": [
        "meta_template/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "feat"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "prConcurrentLimit": 10
  },
  "prConcurrentLimit": 7,
  "extends": [
    "customManagers:githubActionsVersions",
    "config:best-practices"
  ],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json"
}

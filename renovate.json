{
  "customManagers": [
    {
      "description": "matchStrings copied verbatim from the customManagers:githubActionsVersions/gitlabPipelineVersions presets (which only scan .github/workflows and .gitlab-ci.yml), so annotations behave the same in the template's .tmpl files. Update together.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tmpl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_VERSION\\s*:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/copier\\.ya?ml\\.tmpl$/",
        "/copier\\.ya?ml$/"
      ],
      "matchStrings": [
        "_min_copier_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "depNameTemplate": "copier",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/pyproject\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "\"copier>=(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "copier",
      "datasourceTemplate": "pypi"
    }
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/^meta_template/.+/workflows/.+\\.tmpl$/"
    ]
  },
  "packageRules": [
    {
      "description": "Template updates use build commits, which trigger a patch release (see tool.semantic_release in pyproject.toml) so users get them on copier update.",
      "matchFileNames": [
        "meta_template/**"
      ],
      "semanticCommitType": "build"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "astral-sh/uv"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "copier"
      ],
      "automerge": true,
      "groupName": "copier",
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": [
        "go-task/task"
      ],
      "automerge": true
    },
    {
      "description": "Majors in the template can change what generated projects get on copier update, so release them as a minor version listed under Features, after review. Must stay after the automerge rules above.",
      "matchFileNames": [
        "meta_template/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "feat",
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "extends": [
    "customManagers:githubActionsVersions",
    "config:best-practices"
  ],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json"
}

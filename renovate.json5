{
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)requirements.*\\.txt$/"]
  },
  "pip_requirements": {
    // Prefer pip-compile
    "includePaths": ["requirements-base.txt"],
    "enabled": true
  },
  "pip_setup": {
    "enabled": false // as project uses pip-compile
  },
  "extends": ["config:best-practices"],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json"
}

{
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.gitlab-ci\\.ya?ml$"],
      "matchStrings": [
        "https://astral\\.sh/uv/(?<currentValue>[^/]+)/install\\.sh"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)requirements.*\\.txt$/"]
  },
  "pip_requirements": {
    // Prefer pip-compile
    "includePaths": ["requirements-base.txt"],
    "enabled": true
  },
  "pip_setup": {
    "enabled": false // as project uses pip-compile
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    }
  ],
  "extends": ["config:best-practices"],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json"
}
